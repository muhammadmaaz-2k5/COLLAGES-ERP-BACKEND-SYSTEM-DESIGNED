    STUDENT ||--o{ HOSTEL_ALLOCATION : "resides via"
    STUDENT ||--o{ TRANSPORT_SUBSCRIPTION : "commutes via"
    STUDENT ||--o| LIBRARY_MEMBER : "registered as"
    STUDENT ||--o{ PLACEMENT_APPLICATION : "applies for job"
    STUDENT ||--o{ RESEARCH_MEMBER : "participates in"
    STUDENT ||--o{ DOCUMENT : "owns credentials"

    EMPLOYEE ||--o| TEACHER : "faculty role"
    EMPLOYEE ||--o| STAFF : "admin/ops role"
    EMPLOYEE ||--o| DRIVER : "fleet role"
    EMPLOYEE ||--o{ LEAVE_BALANCE : "allocated"
