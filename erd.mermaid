    %% ============ 8. LIBRARY MANAGEMENT ============
    BOOK ||--o{ BOOK_COPY : "cataloged as"
    BOOK_COPY ||--o{ BOOK_ISSUE : "borrowed as"
    LIBRARY_MEMBER ||--o{ BOOK_ISSUE : "borrows"
    BOOK_ISSUE ||--o| FINE : "incurs"

    %% ============ 9. HOSTEL MANAGEMENT ============
    HOSTEL ||--o{ HOSTEL_ROOM : "accommodates"
    HOSTEL_ROOM ||--o{ HOSTEL_ALLOCATION : "assigned to"

    %% ============ 10. TRANSPORT FLEET ============
    VEHICLE ||--o{ ROUTE : "assigned to"
    ROUTE ||--o{ ROUTE_STOP : "navigates through"
    ROUTE ||--o{ TRANSPORT_SUBSCRIPTION : "subscribed by"
    ROUTE_STOP ||--o{ TRANSPORT_SUBSCRIPTION : "picked up at"

    %% ============ 11. CAREER & PLACEMENT ============
    COMPANY ||--o{ JOB_POSTING : "advertises"
    JOB_POSTING ||--o{ PLACEMENT_APPLICATION : "receives candidate"

    %% ============ 12. RESEARCH & PUBLICATIONS ============
    RESEARCH_PROJECT ||--o{ RESEARCH_MEMBER : "staffed by"
    RESEARCH_PROJECT ||--o{ PUBLICATION : "publishes"

    %% ============================================================
    %% ENTITY DEFINITIONS WITH DATA TYPES & KEYS
    %% ============================================================

    INSTITUTION {
        string id PK
        string name
        string code UK
        string email
        string phone
        string address
        string city
        string state
        string country
        string postalCode
        string website
        string logoUrl
        datetime createdAt
        datetime updatedAt
    }

    CAMPUS {
        string id PK
        string institutionId FK
        string name
        string code UK
        string address
        string city
        string state
        string postalCode
        string country
        string phone
        string email
        datetime createdAt
        datetime updatedAt
    }

    SYSTEM_SETTING {
        string id PK
        string institutionId FK
        string key UK
        json value
        string description
        datetime updatedAt
    }

    USER {
        string id PK
        string email UK
        string passwordHash
        enum role
        boolean isActive
        datetime lastLoginAt
        datetime createdAt
        datetime updatedAt
    }

    PERMISSION {
        string id PK
        string code UK
        string label
        string module
    }

    ROLE_PERMISSION {
        string id PK
        enum role
        string permissionId FK
    }

    AUDIT_LOG {
        string id PK
        string userId FK
        string action
        string entityType
        string entityId
        string ipAddress
        string userAgent
        json metadata
        datetime createdAt
    }

    NOTIFICATION_SETTING {
        string id PK
        string userId FK_UK
        boolean emailEnabled
        boolean smsEnabled
        boolean pushEnabled
        boolean examAlerts
        boolean feeAlerts
        boolean resultAlerts
        boolean attendanceAlerts
        boolean leaveAlerts
    }

    NOTIFICATION {
