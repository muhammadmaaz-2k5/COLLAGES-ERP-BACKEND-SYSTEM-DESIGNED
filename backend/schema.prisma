// ============================================================
// UNIVERSITY & COLLEGE ERP — CENTRALIZED PRISMA SCHEMA
// ------------------------------------------------------------
// Architectural Principles:
// 1. ONE SPINE, MANY MODULES:
//    - User: Unified authentication & identity for all actors.
//    - Employee: Shared HR/Payroll/Attendance spine for Faculty (Teacher),
//      Administrative Staff (Staff), and Transport Operators (Driver).
//    - Student: Master academic profile for learners across all lifecycle stages.
// 2. MODULARITY & INTEGRITY:
//    - Strict referential integrity, indexed foreign keys, explicit cascades,
//      and single-source-of-truth calculations for grades, billing, and inventory.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// 0. SYSTEM ENUMS
// ============================================================

