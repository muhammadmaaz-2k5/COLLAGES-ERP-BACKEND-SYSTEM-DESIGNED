    COURSE ||--o{ COURSE_PREREQUISITE : "is prerequisite of (source)"
    COURSE ||--o{ COURSE_OFFERING : "instantiated as"
    SEMESTER ||--o{ STUDENT : "current term for"
    SEMESTER ||--o{ COURSE_OFFERING : "schedules"
    SEMESTER ||--o{ FEE_STRUCTURE : "defines fees for"
    SEMESTER ||--o{ FEE_CHALLAN : "invoices for"
    SEMESTER ||--o{ EXAM_TERM : "holds"
    SEMESTER ||--o{ ANNOUNCEMENT : "targets"
    COURSE_OFFERING ||--o{ TIMETABLE_SLOT : "timetabled in"
    COURSE_OFFERING ||--o{ COURSE_MATERIAL : "supplies"
    COURSE_OFFERING ||--o{ ENROLLMENT : "has enrolled"
    COURSE_OFFERING ||--o{ ATTENDANCE : "tracks"
    COURSE_OFFERING ||--o{ ASSIGNMENT : "assigns"
    COURSE_OFFERING ||--o{ QUIZ : "conducts"
    COURSE_OFFERING ||--o{ EXAM : "evaluates through"
    COURSE_OFFERING }o--o| TEACHER : "taught by"

    %% ============ 4. STUDENT & HR PEOPLE SPINE ============
    STUDENT ||--o| GUARDIAN_INFO : "cared by"
    STUDENT ||--o{ EMERGENCY_CONTACT : "has emergency contact"
    STUDENT ||--o{ ENROLLMENT : "registers in"
