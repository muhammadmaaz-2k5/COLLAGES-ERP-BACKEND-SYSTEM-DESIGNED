# ============================================================================
# 🎓 APEX UNIVERSITY ERP — ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================================

# ----------------------------------------------------------------------------
# 1. CORE SERVER CONFIGURATION
# ----------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ----------------------------------------------------------------------------
# 2. POSTGRESQL DATABASE CONFIGURATION
# ----------------------------------------------------------------------------
DATABASE_URL=postgres://postgres:maaz@localhost:5432/erpc
DB_NAME=erpc
DB_USER=postgres
DB_PASSWORD=maaz
DB_HOST=localhost
DB_PORT=5432
DB_SSL=false

# ----------------------------------------------------------------------------
# 3. JWT AUTHENTICATION SECRETS & EXPIRY
# ----------------------------------------------------------------------------
JWT_SECRET=super-secure-apex-jwt-secret-key-2026-university-erp
JWT_REFRESH_SECRET=super-secure-apex-refresh-secret-key-2026-university-erp
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# ----------------------------------------------------------------------------
# 4. AWS S3 STORAGE CONFIGURATION (Documents, Transcripts, Submissions)
# ----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=eu-north-1
AWS_S3_BUCKET=collage-management-erp-storage

# ----------------------------------------------------------------------------
# 5. CLOUDINARY CDN CONFIGURATION (HD Video Lectures, Streams & Avatars)
# ----------------------------------------------------------------------------
CLOUDINARY_URL=cloudinary://your-api-key:your-api-secret@your-cloud-name
CLOUDINARY_CLOUD_NAME=itomku0j
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_UPLOAD_PRESET=FOODPANDA
CLOUDINARY_SECURE=true
