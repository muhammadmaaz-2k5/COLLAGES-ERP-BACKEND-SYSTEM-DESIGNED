    APPLICATION ||--o| MERIT_LIST_ENTRY : "ranked in"
    ADMISSION_TEST ||--o{ ADMISSION_TEST_RESULT : "grades"

    %% ============ 6. ACADEMIC ASSESSMENTS & GRADING ============
    ASSIGNMENT ||--o{ ASSIGNMENT_SUBMISSION : "receives"
    QUIZ ||--o{ QUIZ_QUESTION : "contains"
    QUIZ ||--o{ QUIZ_ATTEMPT : "logged as"
    QUIZ_QUESTION ||--o{ QUIZ_OPTION : "provides"
    QUIZ_QUESTION ||--o{ QUIZ_ANSWER : "answered as"
    QUIZ_OPTION ||--o{ QUIZ_ANSWER : "selected as"
    QUIZ_ATTEMPT ||--o{ QUIZ_ANSWER : "records"
    EXAM_TERM ||--o{ EXAM : "aggregates"
    EXAM ||--o{ EXAM_RESULT : "generates"
    EXAM ||--o{ EXAM_INVIGILATOR : "invigilated by"

    %% ============ 7. FINANCE & ACCOUNTS ============
    FEE_STRUCTURE ||--o{ FEE_STRUCTURE_ITEM : "itemizes"
    FEE_STRUCTURE ||--o{ FEE_CHALLAN : "bases"
    FEE_CHALLAN ||--o{ FEE_CHALLAN_ITEM : "bills item"
    FEE_CHALLAN ||--o{ PAYMENT : "settled through"
    SCHOLARSHIP_PROGRAM ||--o{ SCHOLARSHIP_AWARD : "grants"
