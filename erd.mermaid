    %% ============ 1. IDENTITY & ACCESS MANAGEMENT ============
    INSTITUTION ||--o{ CAMPUS : "operates"
    INSTITUTION ||--o{ SYSTEM_SETTING : "configures"
    USER ||--o| STUDENT : "has identity"
    USER ||--o| EMPLOYEE : "has identity"
    USER ||--o| NOTIFICATION_SETTING : "manages"
    USER ||--o{ NOTIFICATION : "receives"
    USER ||--o{ AUDIT_LOG : "triggers"
    USER ||--o{ MESSAGE : "sends (sender)"
    USER ||--o{ MESSAGE : "receives (receiver)"
    USER ||--o{ ANNOUNCEMENT : "publishes"
    USER ||--o{ CUSTOM_REPORT : "creates"
    PERMISSION ||--o{ ROLE_PERMISSION : "granted via"

    %% ============ 2. CAMPUS INFRASTRUCTURE & FACILITIES ============
    CAMPUS ||--o{ BUILDING : "contains"
    CAMPUS ||--o{ DEPARTMENT : "houses"
    BUILDING ||--o{ ROOM : "contains"
    ROOM ||--o{ TIMETABLE_SLOT : "hosts class"
    ROOM ||--o{ EXAM : "hosts exam"
    ROOM ||--o{ ROOM_BOOKING : "booked for"
    ROOM ||--o| HOSTEL_ROOM : "configured as"
    ROOM ||--o{ ASSET : "locates"
    ROOM ||--o{ MAINTENANCE_REQUEST : "needs maintenance"
    ASSET ||--o{ MAINTENANCE_REQUEST : "requires repair"

    %% ============ 3. ACADEMIC STRUCTURE & CURRICULUM ============
    DEPARTMENT ||--o{ PROGRAM : "offers"
    DEPARTMENT ||--o{ COURSE : "curates"
    DEPARTMENT ||--o{ EMPLOYEE : "employs"
    DEPARTMENT ||--o{ ANNOUNCEMENT : "targets"
    PROGRAM ||--o{ DEGREE_REQUIREMENT : "prescribes"
