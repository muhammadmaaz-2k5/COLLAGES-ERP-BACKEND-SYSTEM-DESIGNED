    EMPLOYEE ||--o| LIBRARY_MEMBER : "borrowing rights"
    EMPLOYEE ||--o{ TRANSPORT_SUBSCRIPTION : "commutes via"

    LEAVE_TYPE ||--o{ LEAVE_BALANCE : "defines quota"
    LEAVE_TYPE ||--o{ LEAVE_REQUEST : "categorizes"
    TEACHER ||--o{ QUIZ : "creates"
    TEACHER ||--o{ RESEARCH_MEMBER : "leads / joins"
    STAFF ||--o{ HOSTEL : "wardens"
    DRIVER ||--o{ VEHICLE : "drives"

    %% ============ 5. ADMISSIONS & SELECTION ============
    APPLICANT ||--o{ APPLICATION : "files"
